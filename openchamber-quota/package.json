{
  "name": "antigravity-quota",
  "version": "2.3.0",
  "description": "Antigravity quota in OpenChamber's Work Status, read from agy's own /quota command",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "contributes": {
      "panel": {
        "id": "antigravity-quota",
        "name": "Antigravity",
        "icon": "rocket"
      },
      "background": {
        "entry": "command/index.html"
      },
      "commands": [
        {
          "name": "agy-quota",
          "description": "Show Antigravity's 5-hour and weekly quota"
        }
      ],
      "statusSection": {
        "entry": "status/index.html",
        "title": "Antigravity",
        "height": 24
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "agy"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.8.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "@types/bun": "^1.4.2"
  }
}
