{
  "name": "antigravity-quota",
  "version": "1.1.0",
  "description": "Antigravity quota in OpenChamber's Work Status and Usage page, read from agy's own /quota command",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "contributes": {
      "panel": {
        "id": "antigravity-quota",
        "name": "Antigravity",
        "icon": "rocket"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Antigravity",
        "height": 24
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "quota"
        ],
        "permissions": {
          "exec": [
            "agy"
          ]
        }
      },
      "quota": {
        "providers": []
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.8.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "@types/bun": "^1.4.2"
  }
}
